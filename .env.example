# ========================================================
# 24/7 BINANCE FUTURES SCANNER & TELEGRAM BOT CONFIGURATION
# ========================================================

# Telegram Bot Credentials
# Obtain BOT_TOKEN from https://t.me/BotFather
# Obtain CHAT_ID from https://t.me/userinfobot or invite bot to your channel/group
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_CHAT_ID="-100123456789"
TELEGRAM_ENABLED=true
TELEGRAM_COOLDOWN_MINUTES=15

# Binance Perpetual Futures Scanning
BINANCE_TIMEFRAME="5m"              # Options: 1m, 3m, 5m, 15m, 30m, 1h, 4h, 1d
SCAN_INTERVAL_SECONDS=30            # Frequency of full market scan passes
MAX_CONCURRENT_REQUESTS=8           # Rate-limiting concurrent workers
REQUEST_DELAY_SECONDS=0.05          # Spacing between API requests to prevent 429/418 bans

# Strategy Rules (EMA 11/34 + VWAP + EMA 200 Zone)
EMA_FAST=11
EMA_SLOW=34
EMA_TREND=200
ATR_PERIOD=14
SL_ATR_MULT=2.5                     # Stop Loss distance = 2.5 * ATR
TP1_RATIO=1.5                       # Take Profit 1 = SL * 1.5 (Risk-to-Reward 1:1.5)
TREND_FILTER="zone"                 # "zone" (VWAP vs EMA 200), "price" (Price vs VWAP & EMA 200), or "none"
REQUIRE_CANDLE_COLOR=true           # Require Green candle for LONG, Red for SHORT
REQUIRE_WEEKLY_VWAP=false           # Require weekly VWAP alignment filter
BAR_COOLDOWN=3                      # Minimum completed bars between repeat signals on same pair

# Server & Storage
PORT=8000
HOST="0.0.0.0"
DATABASE_PATH="signals.db"
DEBUG=false
